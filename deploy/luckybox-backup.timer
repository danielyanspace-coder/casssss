# Расписание резервного копирования.
#
# Раз в час, а не раз в сутки: за сутки набегают открытия кейсов, пополнения и
# заявки на вывод, и потерять их целиком - это разбирательства с игроками,
# которым нечего предъявить. Час копий на диске при базе в несколько мегабайт
# стоит копейки.

[Unit]
Description=LuckyBox - копия базы раз в час

[Timer]
OnCalendar=hourly
# Если сервер был выключен в момент запуска, копия делается сразу после
# включения, а не пропускается до следующего часа.
Persistent=true
# Разброс, чтобы копирование не совпадало с ровным часом, когда и так пик.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
