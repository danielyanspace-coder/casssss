# Скопируйте в .env и заполните:  cp .env.example .env

# --- Сайт ---

# Публичный HTTPS-адрес сайта. Из него собираются ссылки в письмах, адреса
# колбэков платёжных шлюзов и кнопка бота. Старое имя WEBAPP_URL тоже читается.
SITE_URL=https://example.com

# Владельцы панели: Telegram ID через запятую и/или почты аккаунтов через
# запятую. Остальных сотрудников владелец заводит в панели. Свой Telegram ID
# можно узнать у @userinfobot. В DEV_MODE тестовый игрок имеет ID 999000001.
# Главный админ проекта - эта почта (решение заказчика, см. deploy/SECRETS.md):
# аккаунт, зарегистрированный на неё, сразу получает права владельца.
ADMIN_TG_IDS=
ADMIN_EMAILS=garfield1999karlos123@gmail.com

# --- Вход через Telegram и бот (необязательно) ---
#
# Без них сайт работает: вход по почте и паролю. С ними появляется кнопка
# «Войти через Telegram», привязка Telegram в профиле, бесплатный кейс за
# подписку на канал и напоминания бота.
#
# Виджет входа работает только на домене, указанном боту в @BotFather
# командой /setdomain. Имя бота - без @.
TELEGRAM_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Служебный бот: оповещения о сбоях и вход в панель ---
#
# Отдельный бот из @BotFather, НЕ тот, что в TELEGRAM_TOKEN: его обновления
# читает сервер, а два читателя на одном токене Telegram не допускает.
# С ним вход в панель подтверждается в Telegram, а владельцам приходят
# оповещения о сбоях (сервер, сайт, шлюзы, казино, копии базы, диск).
# Привязка - в панели: сотрудник жмёт «Открыть служебного бота» и Start.
OPS_BOT_TOKEN=
# Telegram главного админа: подтверждения входа в панель и оповещения идут
# сюда сразу, без привязки из панели, и другой Telegram к владельцу не
# привязать. Бот может писать только тому, кто хоть раз нажал у него Start.
OPS_OWNER_CHAT_ID=8602356502
# Дополнительный чат для оповещений (группа команды), через запятую. Узнать
# id группы: добавить туда бота, написать сообщение, открыть
# https://api.telegram.org/bot<токен>/getUpdates. Необязательно.
OPS_ALERT_CHAT_ID=
# Аварийный ключ: off выключает подтверждение входа, если Telegram недоступен,
# а в панель нужно срочно. Только на время аварии.
# OPS_2FA=off

# --- Почта (необязательно) ---
#
# Нужна для «Забыли пароль?». Без неё форма предлагает написать в поддержку.
# Основной путь - Resend: ключ только на отправку (Sending access) из
# resend.com/api-keys. Пока домен не подтверждён в resend.com/domains, письма
# уходят только с onboarding@resend.dev и только на почту владельца аккаунта
# Resend; после подтверждения поменяйте MAIL_FROM на адрес своего домена.
RESEND_API_KEY=
MAIL_FROM=LUCKYBOX <onboarding@resend.dev>
# Запасной путь вместо Resend: SMTP_URL=smtps://логин:пароль@smtp.example.com:465
# Значение log печатает письма в журнал сервера - только для разработки.
SMTP_URL=

# --- Необязательно ---

PORT=3000

# Файл базы данных SQLite
DB_PATH=./data/app.db

# Любой запрос без входа считается запросом тестового игрока. Нужно для
# разработки и автотестов на localhost. Это выключенная авторизация, а не
# режим отладки: в продакшене ОБЯЗАТЕЛЬНО false.
DEV_MODE=false

# Ключ шифрования номеров карт в заявках на вывод.
# 32 случайных байта в base64 или 64 hex-символа. Не менять после появления заявок по карте.
PAYOUT_DATA_KEY=


# Бонус: сколько начисляем, как часто и при каком балансе он доступен
BONUS_AMOUNT=500
BONUS_COOLDOWN_MIN=60
BONUS_BALANCE_LIMIT=250


# --- Криптокасса Heleket ---
#
# Ключи берутся в кабинете Heleket: Настройки -> API. Нужен именно платёжный
# ключ (Payment API key), выплатной здесь не используется - заявки на вывод
# проходят через админку руками.
#
# Если оставить пустыми, криптокасса просто не показывается: ни в пополнении,
# ни в выводе. Это рабочее состояние, а не поломка.
HELEKET_MERCHANT=
HELEKET_API_KEY=

# Границы пополнения криптой, рублей.
CRYPTO_MIN=500
CRYPTO_MAX=500000

# Сколько живёт выставленный счёт, секунд. Меньше часа мало: перевод в сети
# идёт долго, и счёт истечёт раньше, чем дойдут деньги.
CRYPTO_INVOICE_LIFETIME=10800

# Проверять ли адрес, с которого пришёл вебхук (31.133.220.8). Подпись и так
# закрывает подделку; адрес добавляет второй рубеж, но при неверно посчитанном
# TRUST_PROXY_HOPS молча зарубит настоящие зачисления. Включать осознанно,
# убедившись, что в логах виден адрес шлюза.
HELEKET_CHECK_IP=false

# --- СБП и карта: шлюз Sicilia (server/sicilia.js) ---
#
# Мерчант, логин и API-ключ - из кабинета https://merchant.sicilia.ink/.
# Логин - тот, что входит в подписи sha256('login:sum:invid:apiKey'); уточнить
# у них, совпадает ли он с почтой входа. В репозиторий ключ не кладём.
# Пустые - вкладка «СБП и карта» в кассе не показывается.
SICILIA_MERCHANT=
SICILIA_LOGIN=
SICILIA_API_KEY=
SICILIA_API_URL=https://api.sicilia.ink/api
# Адрес их платёжного окна ({{base_payment_url}} в документации). Прислан
# партнёром в октябре 2026; окно под наш мерчант они настраивают у себя, и
# пока не настроили, ссылка не откроет оплату. Пустой - пополнение выключено,
# а выплаты через панель работают.
SICILIA_PAY_URL=https://payment.sicilia.ink
# Границы пополнения, рублей, и сколько ждём оплату до отзыва ордера, минут.
SICILIA_MIN=500
SICILIA_MAX=300000
SICILIA_ORDER_TTL_MIN=30
# Адреса шлюза, с которых приходят колбэки, через запятую. Пусто - не
# проверяем: подпись и перепроверка статуса закрывают подделку и без этого.
# 91.206.228.46 прислал партнёр «для белых списков». Если окажется, что колбэки
# идут с другого адреса, они получат 403, а деньги всё равно зачислит сверка
# раз в 5 минут: в журнале будет «чужой адрес», адрес надо дописать сюда.
SICILIA_CALLBACK_IPS=91.206.228.46

# --- Ограничение частоты запросов ---
#
# Сколько запросов в минуту разрешено одному игроку. Значения по умолчанию
# рассчитаны на живого человека и в обычной игре не заметны; поднимать их
# нужно, только если упрётся настоящий поток игроков.
# play    - открытие кейсов, ставки, покупка фриспинов
# cashier - заявки на вывод и пополнение
# guess   - промокоды и всё, что подбирается перебором
# read    - списки, история, лента
# webhook - приём SMS от платёжного шлюза
RATE_LIMIT_PLAY=90
RATE_LIMIT_CASHIER=12
RATE_LIMIT_GUESS=8
RATE_LIMIT_READ=240
RATE_LIMIT_WEBHOOK=120

# Сколько обратных прокси стоит перед приложением. Один nginx на том же
# сервере - это 1. Нужно, чтобы ограничитель видел настоящий адрес клиента,
# а не адрес nginx. Доверять всей цепочке нельзя: заголовок подделывается.
TRUST_PROXY_HOPS=1

# --- Резервное копирование ---
#
# Куда складывать копии базы и сколько держать. Копия рядом с базой спасает от
# испорченной записи и ошибочного удаления, но не от потери сервера: настоящая
# копия - та, что уехала на другую машину.
BACKUP_DIR=./data/backups
BACKUP_KEEP=14
# Адрес удалённого хранилища для rclone, например: s3:luckybox-backups
# Пусто - копии остаются только на этом сервере.
RCLONE_REMOTE=

# Поощрение за первое пополнение: процент, потолок в рублях, минимальная сумма
# и множитель отыгрыша бонуса. FIRST_DEPOSIT_PCT=0 выключает поощрение.
FIRST_DEPOSIT_PCT=100
FIRST_DEPOSIT_MAX=1000
FIRST_DEPOSIT_MIN=500
FIRST_DEPOSIT_WAGER=2

# Напоминания бота: как часто проверять поводы и сколько ждать перед
# напоминанием о недокрученных фриспинах, минут
BOT_SWEEP_MIN=30
BOT_SPINS_WAIT_MIN=90

# Медаль «Десятикратный»: после стольких платных открытий кейсов игрок один
# раз получает ×10 к следующему денежному выигрышу. Тысяча открытий приносят
# кассе в среднем 300 цен кейса, награда стоит около 6.3 цены, то есть ~2%.
# Ниже ~420 доля поднимается выше 5% - это уже решение о марже.
X10_MEDAL_OPENS=1000
# Потолок доплаты медали, в ценах кейса: ×10 на верхнем призе без потолка
# стоил бы сотни цен разом.
X10_MEDAL_CAP=50

# Агрегатор игр провайдеров (Databetrix), раздел «Казино». Имя и ключ агента
# - в кабинете агрегатора (backoffice.aggregator.databetrix.com, профиль
# агента). Ключ даёт право запускать игры за деньги: в репозиторий его не
# кладём. Без ключа сервер работает на снимке каталога, запуск отключён.
DATABETRIX_BASE_URL=https://api.game.databetrix.com
DATABETRIX_AGENT_NAME=
DATABETRIX_AGENT_TOKEN=
# Адреса серверов агрегатора, с которых приходят вызовы кошелька. Пусто -
# проверка выключена (только для разработки, на сервере - никогда).
CASINO_CALLBACK_IPS=51.20.178.99,51.20.217.36
# Пределы отдачи, которые разрешает кабинет агрегатора. Настройка «Отдача
# слотов казино» в панели зажимается в них.
CASINO_RTP_MIN=70
CASINO_RTP_MAX=80
# Как часто обновлять каталог игр, часов.
CASINO_SYNC_HOURS=6
# Страна игрока для агрегатора, если её не сообщает Cloudflare.
CASINO_COUNTRY=RU
# Провайдеры, открытые партнёром, через запятую. Пусто - список из кода
# (DEFAULT_PROVIDERS в server/casino.js).
CASINO_PROVIDERS=
# Открытое API витрины партнёра: топ и новинки для блоков «Популярные» и
# «Новинки». Недоступна - каталог собирается без них.
CASINO_STOREFRONT_URL=https://api.betinovioslots.net
CASINO_STOREFRONT_AGENT=multitest
