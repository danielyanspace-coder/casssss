{
  "name": "case-simulator-miniapp",
  "version": "1.0.0",
  "description": "Telegram Mini App: симулятор открытия кейсов на условных единицах",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/app.js",
    "bot": "node server/bot.js",
    "dev": "DEV_MODE=true RATE_LIMIT_PLAY=100000 RATE_LIMIT_READ=100000 RATE_LIMIT_CASHIER=100000 RATE_LIMIT_GUESS=100000 RATE_LIMIT_AUTH=100000 node server/app.js",
    "verify": "node server/verify.js",
    "demo": "node build-standalone.mjs",
    "test:api": "node test/api.mjs",
    "test:ui": "node test/ui.mjs",
    "test:cashier-ui": "node test/cashier-ui.mjs",
    "test:startup-ui": "node test/startup-ui.mjs",
    "test:x2": "node test/x2.mjs",
    "test:casino": "node test/casino-demo.mjs && node test/casino-demo-ui.mjs && node test/casino.mjs && node test/casino-home-cache.mjs && node test/casino-navigation.mjs && node test/casino-lifecycle.mjs && node test/casino-catalog-requests.mjs",
    "test": "npm run verify && npm run test:modules && npm run test:startup && npm run test:ratelimit && npm run test:x2 && npm run test:accounts && npm run test:wager && npm run test:payout-check && npm run test:crypto && npm run test:sicilia && npm run test:auth && npm run test:ops && npm run test:analytics && npm run test:fortune && npm run test:slots && npm run test:casino && npm run test:api && npm run test:ui",
    "test:ratelimit": "node test/ratelimit.mjs",
    "backup": "node deploy/backup.mjs",
    "test:crypto": "node test/crypto.mjs",
    "test:sicilia": "node test/sicilia.mjs",
    "test:auth": "node test/auth.mjs",
    "test:ops": "node test/ops.mjs",
    "test:wager": "node test/wager.mjs",
    "test:start-case": "node test/start-case.mjs",
    "test:broadcast": "node test/broadcast.mjs && node test/bot-menu.mjs",
    "test:partners": "node test/partners.mjs",
    "test:payout-check": "node test/payout-check.mjs",
    "test:analytics": "node test/analytics.mjs",
    "test:fortune": "node test/fortune.mjs",
    "test:modules": "node --experimental-vm-modules test/modules.mjs && node test/client-technical.mjs",
    "test:slots": "node test/slots.mjs",
    "test:cards": "node test/cards.mjs",
    "test:art": "node test/art.mjs && node test/art-cache.mjs",
    "test:casino-covers": "node test/casino-covers.mjs",
    "test:performance-ui": "node test/performance-ui.mjs",
    "perf:audit": "node tools/perf-audit.mjs",
    "demo:motion": "node tools/motion-demo.mjs",
    "demo:fs-total": "node tools/series-total-demo.mjs",
    "demo:admin": "DEMO_ADMIN=1 node build-standalone.mjs && cp dist/luckybox.html dist/luckybox-admin.html && node build-standalone.mjs",
    "test:startup": "node --experimental-vm-modules test/startup.mjs",
    "audit:startup": "node --experimental-vm-modules tools/startup-audit.mjs",
    "measure:startup": "node tools/measure-startup.mjs",
    "test:accounts": "node test/accounts-rewards.mjs && node test/case-exit.mjs",
    "test:accounts-ui": "node test/accounts-ui.mjs",
    "build:client": "node tools/build-feed-art.mjs && node tools/build-client.mjs",
    "build:images": "node tools/responsive-images.mjs",
    "test:case-catalog": "node test/case-catalog.mjs",
    "test:lazy-ui": "node test/lazy-sections.mjs",
    "test:catalog-ui": "node test/catalog-ui.mjs",
    "test:client-technical": "node test/client-technical.mjs",
    "test:resilience": "node test/resilience.mjs && node test/lifecycle-resilience.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "grammy": "^1.30.0",
    "nodemailer": "^10.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "1.64.1"
  },
  "overrides": {
    "qs": "^6.16.1"
  }
}
