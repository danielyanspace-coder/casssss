{
  "name": "case-simulator-miniapp",
  "version": "1.0.0",
  "description": "Telegram Mini App: симулятор открытия кейсов на условных единицах",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/app.js",
    "bot": "node server/bot.js",
    "dev": "DEV_MODE=true node server/app.js",
    "verify": "node server/verify.js",
    "demo": "node build-standalone.mjs",
    "test:api": "node test/api.mjs",
    "test:ui": "node test/ui.mjs",
    "test": "npm run verify && npm run test:x2 && npm run test:api && npm run test:ui",
    "test:x2": "node test/x2.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "playwright": "^1.48.0"
  }
}
